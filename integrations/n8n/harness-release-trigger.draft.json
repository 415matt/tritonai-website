{
  "name": "TritonAI Harness stable release website update",
  "nodes": [
    {
      "id": "6f8695b4-a3c4-5a08-b944-80f06329412f",
      "name": "Daily release check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "cafe3d56-881c-559c-891e-edbd82d028c1",
      "name": "Test release check",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        500
      ],
      "parameters": {}
    },
    {
      "id": "harness-repository-worker",
      "name": "Run verified release maintenance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        350,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/bpollak/tritonai-website/actions/workflows/harness-release-maintenance.yml/dispatches",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2026-03-10"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"ref\":\"main\",\"inputs\":{\"publish\":true}}",
        "options": {
          "timeout": 30000
        }
      },
      "notes": "GitHub API 2026-03-10 returns the exact run ID. This workflow waits for that run to complete; the worker verifies the branch publication and all affected public pages."
    },
    {
      "id": "harness-maintenance-notes",
      "name": "Release maintenance scope",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        -100
      ],
      "parameters": {
        "content": "## Harness stable release maintenance\nDaily at 8 AM America/Los_Angeles (including weekends).\n\nn8n starts the repository worker. No dependency on the maintainer Mac. The worker checks stable Harness and guided Installer versions separately, stops unchanged runs without model calls, verifies summaries and page guidance with UC-hosted GLM 5.3, runs site tests, pushes scoped release files and verifies production.\n\nRead the GitHub Actions result for completion or failure. Keep the dedicated GitHub credential outside exported workflow JSON.",
        "width": 650,
        "height": 290
      }
    },
    {
      "id": "wait-for-worker",
      "name": "Wait for publication verification",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        600,
        300
      ],
      "parameters": {
        "amount": 1,
        "unit": "minutes"
      }
    },
    {
      "id": "read-worker-result",
      "name": "Read matching worker result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        300
      ],
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/bpollak/tritonai-website/actions/runs/' + Number($('Run verified release maintenance').first().json.workflow_run_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "worker-completed",
      "name": "Worker completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "worker-completed-condition",
              "leftValue": "={{ $json.status === 'completed' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "publication-verified",
      "name": "Publication verified",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1350,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "publication-verified-condition",
              "leftValue": "={{ $json.conclusion === 'success' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "bounded-wait",
      "name": "Wait limit reached",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1350,
        450
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "bounded-wait-condition",
              "leftValue": "={{ $runIndex >= 59 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "fail-worker",
      "name": "Release maintenance failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1600,
        400
      ],
      "parameters": {
        "errorMessage": "={{ 'Harness release worker failed or exceeded its wait limit. Inspect https://github.com/bpollak/tritonai-website/actions/runs/' + $('Run verified release maintenance').first().json.workflow_run_id }}"
      }
    },
    {
      "id": "verified-result",
      "name": "Release maintenance verified",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1600,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "value": "production_verified_or_unchanged",
              "type": "string"
            },
            {
              "id": "run-url",
              "name": "run_url",
              "value": "={{ 'https://github.com/bpollak/tritonai-website/actions/runs/' + $('Run verified release maintenance').first().json.workflow_run_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Daily release check": {
      "main": [
        [
          {
            "node": "Run verified release maintenance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Test release check": {
      "main": [
        [
          {
            "node": "Run verified release maintenance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run verified release maintenance": {
      "main": [
        [
          {
            "node": "Wait for publication verification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for publication verification": {
      "main": [
        [
          {
            "node": "Read matching worker result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read matching worker result": {
      "main": [
        [
          {
            "node": "Worker completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Worker completed": {
      "main": [
        [
          {
            "node": "Publication verified",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait limit reached",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publication verified": {
      "main": [
        [
          {
            "node": "Release maintenance verified",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Release maintenance failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait limit reached": {
      "main": [
        [
          {
            "node": "Release maintenance failed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for publication verification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Los_Angeles",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "executionTimeout": 3900
  },
  "active": false
}
